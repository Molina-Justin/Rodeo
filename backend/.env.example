RODEO_ENVIRONMENT=development
RODEO_DATA_DIR=./.data
RODEO_TIMEZONE=America/New_York
RODEO_PUBLIC_URL=http://127.0.0.1:8000
RODEO_STATIC_DIR=./static
RODEO_ALLOWED_HOSTS='["127.0.0.1", "localhost", "testserver"]'
RODEO_ALLOWED_ORIGINS='["http://127.0.0.1:5199", "http://localhost:5199"]'
RODEO_BACKUP_ENABLED=true
RODEO_BACKUP_INTERVAL_HOURS=24
RODEO_BACKUP_RETENTION=14
RODEO_BACKUP_INCLUDE_RECORDINGS=true
RODEO_TRANSCRIPTION_ENABLED=true
RODEO_TRANSCRIPTION_MODEL=base.en
